# Environment Configuration (development / production)
NODE_ENV=development
PORT=5500

# Database Configuration
MONGO_URI=mongodb://localhost:27017/Attendance
MONGO_DB_NAME=Attendance

# Authentication & Security
JWT_SECRET=your_jwt_super_secret_key_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple allowed origins)
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,https://your-frontend-app.vercel.app

# Cloudinary Storage Configuration
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Configuration
SMTP_EMAIL=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
HR_EMAIL=hr@yourcompany.com

# Optional AI Chat Configuration (Gemini)
GEMINI_API_KEY=your_gemini_api_key
